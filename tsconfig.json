{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "lib": ["DOM", "ES2020"],
    "paths": {
      "@support/*": ["cypress/support/*"],
      "@pageObjects/*": ["cypress/src/pageObjects/*"],
      "@utils/*": ["cypress/src/utilities/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "cypress", "cypress-cucumber-preprocessor"]
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts"],
  "exclude": ["node_modules", "dist"]
}
